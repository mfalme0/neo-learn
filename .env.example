# Copy to .env and adjust. Never commit .env.

# HTTP server
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=15s
LOG_LEVEL=info

# Postgres. Host port 5433 in docker-compose.yml, so 5432 may already be taken
# by a local Postgres.
DATABASE_URL=postgres://neolearn:neolearn@localhost:5433/neolearn?sslmode=disable

# Redis (sessions)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Sessions. Changing this invalidates all existing sessions.
SESSION_COOKIE_NAME=neo_session
SESSION_TTL=168h
# Secure requires HTTPS; leave false for local http development.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=

# Argon2id password hashing
ARGON2_TIME=3
ARGON2_MEMORY_KIB=65536
ARGON2_THREADS=2

# Web origin allowed to call the API with credentials (CORS + CSRF).
WEB_ORIGIN=http://localhost:3000

# Comma-separated list of trusted reverse-proxy IPs, empty to trust none.
TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# SMS
# ---------------------------------------------------------------------------

# Shared secret the provider presents on inbound webhooks. Leave empty to
# disable inbound delivery entirely: with no secret there is no safe way to
# authenticate a webhook, so the route is not mounted rather than mounted and
# rejecting every request.
SMS_INBOUND_SECRET=

# "log" records outbound messages to stdout and needs no provider account.
# Replace with a real sms.Gateway implementation for a live deployment.
SMS_GATEWAY=log

# Outbox drain worker.
SMS_WORKER_ENABLED=true
SMS_WORKER_POLL_INTERVAL=5s
SMS_WORKER_BATCH_SIZE=25
# Attempts before a message is marked dead and stops costing money.
SMS_WORKER_MAX_ATTEMPTS=6
SMS_WORKER_BASE_BACKOFF=30s
SMS_WORKER_MAX_BACKOFF=30m
# How long a claim survives before another worker may reclaim the row. Covers a
# worker being killed mid-delivery.
SMS_WORKER_STALE_CLAIM=2m

# Signing phrase at the top of every outbound message. A learner receiving
# several texts needs to tell course material from anything else.
SMS_BRAND=NEO LEARN